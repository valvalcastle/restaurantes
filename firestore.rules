rules_version = '2';

// Sprint 1: ningún cliente (navegador/móvil) accede directo a Firestore.
// Toda la lectura/escritura pasa por FastAPI con el Admin SDK, que ignora estas reglas.
// En el Sprint 2 se reemplazan por reglas con autenticación y ownerId.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
