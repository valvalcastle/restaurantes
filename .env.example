APP_NAME=FriendlyEats FastAPI
ENVIRONMENT=local

# Con el prefijo "demo-" el emulador funciona sin login ni proyecto real.
# Cuando tengas tu proyecto Firebase real, pon aquí su ID.
FIREBASE_PROJECT_ID=demo-friendlyeats

# Solo se usa contra Firestore real (NO contra el emulador).
# Nunca subas este archivo JSON a Git.
# FIREBASE_CREDENTIALS_PATH=./secrets/service-account.json

# Si está definido, la app habla con el emulador local.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
